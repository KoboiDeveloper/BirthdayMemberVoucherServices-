# Copy to .env for local runs, or set these in Coolify → Environment Variables.
# Do NOT commit real secrets.

API_URL=https://your-api-host/birthday-mail
API_TOKEN=your_api_token_here

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=noreply@example.com
SMTP_PASS=your_smtp_app_password
SMTP_FROM=AMSCORP <noreply@example.com>

